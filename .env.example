# ==============================================================================
# Brand Guardian AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment.
# Never commit real secrets or production passwords to source control.
# ==============================================================================

# --- RUNTIME ENVIRONMENT ---
# Options: development | staging | production
ENVIRONMENT=development
DEBUG=false
APP_VERSION=3.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,api,frontend

# --- PORTS ---
API_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- DATABASE CONFIGURATION ---
# Local SQLite default (for local testing):
# DATABASE_URL=sqlite:///./brand_guardian.db
# Production Docker PostgreSQL:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=brand_guardian
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/brand_guardian

# --- REDIS QUEUE CONFIGURATION ---
# In development, REDIS_REQUIRED=false allows fallback to local in-memory queue.
# In production, REDIS_REQUIRED=true is strictly enforced to prevent silent fallback.
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# --- SECURITY & JWT AUTHENTICATION ---
# IMPORTANT: In production, JWT_SECRET_KEY must be >= 32 characters and NOT a placeholder.
JWT_SECRET_KEY=brand-guardian-dev-insecure-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS SETTINGS ---
# Comma-separated list of allowed origins.
# In production, wildcard (*) is strictly prohibited when credentials are enabled.
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost:3000,http://127.0.0.1:4200,http://127.0.0.1:80

# --- RESOURCE & SAFETY LIMITS ---
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_FRAMES=20
MAX_VISION_FRAMES=10
MAX_RETRIES=3
AUDIT_RETENTION_DAYS=30

# --- STRUCTURED OBSERVABILITY ---
LOG_FORMAT=json
LOG_LEVEL=INFO

# ==============================================================================
# OPTIONAL AZURE SERVICES (Leave empty to use local degraded OCR fallback)
# ==============================================================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=compliance-rules-index
AZURE_VI_NAME=project-brand-guardian-001
AZURE_VI_LOCATION=
AZURE_VI_ACCOUNT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
APPLICATIONINSIGHTS_CONNECTION_STRING=
LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
