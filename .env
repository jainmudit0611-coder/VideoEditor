# ==============================================================================
# Brand Guardian AI — Environment Configuration (.env)
# ==============================================================================

# --- RUNTIME ENVIRONMENT ---
ENVIRONMENT=development
DEBUG=false
APP_VERSION=3.0.0
ALLOWED_HOSTS=localhost,127.0.0.1,api,frontend

# --- PORTS ---
API_PORT=8000
FRONTEND_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- DATABASE CONFIGURATION ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=brand_guardian
DATABASE_URL=sqlite:///./brand_guardian.db

# --- REDIS QUEUE CONFIGURATION ---
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false

# --- SECURITY & JWT AUTHENTICATION ---
JWT_SECRET_KEY=brand-guardian-dev-insecure-secret-key-change-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS SETTINGS ---
CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200,http://127.0.0.1:80

# --- RESOURCE & SAFETY LIMITS ---
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600
MAX_FRAMES=20
MAX_VISION_FRAMES=10
MAX_RETRIES=3
AUDIT_RETENTION_DAYS=30

# --- STRUCTURED OBSERVABILITY ---
LOG_FORMAT=json
LOG_LEVEL=INFO

